# Public — safe to ship to the browser. Get these from Supabase project settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://crqbukrebsribweqqnfo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_wWqtZGOPSE5mwFn4xySC7A_GSSNxAzF

# Server-only — NEVER prefix with NEXT_PUBLIC_, never expose to the client.
# Set this in Vercel under Project Settings > Environment Variables, not in
# a committed file.
ANTHROPIC_API_KEY=sk-ant-...

# Server-only, bypasses Row Level Security — required for the CEO validation
# link route (src/app/api/validate/[token], src/lib/supabase/service.ts),
# whose recipient has no account/session. Get it from Supabase project
# settings > API > service_role. Never expose to the client, never log it.
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_...

# Optional — overrides the matching model if claude-sonnet-4-6 isn't
# enabled on your Anthropic account yet.
# ANTHROPIC_MODEL=claude-sonnet-4-5
